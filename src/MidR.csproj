<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
		<Version>5.3.0</Version>
		<Authors>Guilherme</Authors>
		<Company>GR-Code</Company>
		<Description>Library that facilitates working with Mediator Pattern</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/Guidev123/MidR</RepositoryUrl>
		<PackageProjectUrl>https://github.com/Guidev123/MidR</PackageProjectUrl>
		<Nullable>enable</Nullable>
		<IsPackable>true</IsPackable>
		<PackageIcon>image.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions">
			<Version Condition="'$(TargetFramework)' == 'net6.0'">6.0.0</Version>
			<Version Condition="'$(TargetFramework)' == 'net7.0'">7.0.0</Version>
			<Version Condition="'$(TargetFramework)' == 'net8.0'">8.0.0</Version>
			<Version Condition="'$(TargetFramework)' == 'net9.0'">9.0.0</Version>
			<Version Condition="'$(TargetFramework)' == 'net10.0'">10.0.0</Version>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions">
			<Version Condition="'$(TargetFramework)' == 'net6.0'">6.0.0</Version>
			<Version Condition="'$(TargetFramework)' == 'net7.0'">7.0.0</Version>
			<Version Condition="'$(TargetFramework)' == 'net8.0'">8.0.0</Version>
			<Version Condition="'$(TargetFramework)' == 'net9.0'">9.0.0</Version>
			<Version Condition="'$(TargetFramework)' == 'net10.0'">10.0.0</Version>
		</PackageReference>
		<PackageReference Include="Microsoft.Extensions.Logging">
			<Version Condition="'$(TargetFramework)' == 'net6.0'">6.0.0</Version>
			<Version Condition="'$(TargetFramework)' == 'net7.0'">7.0.0</Version>
			<Version Condition="'$(TargetFramework)' == 'net8.0'">8.0.0</Version>
			<Version Condition="'$(TargetFramework)' == 'net9.0'">9.0.0</Version>
			<Version Condition="'$(TargetFramework)' == 'net10.0'">10.0.0</Version>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<None Include="image.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="MidR.UnitTests" />
	</ItemGroup>
</Project>
